target/
ffmpeg/

# yt-dlp installs itself here the first time a link is downloaded. Unlike
# ffmpeg it is not mirrored in this repository: it goes stale in weeks, so a
# committed copy would be wrong long before anyone noticed.
yt-dlp/

# The built binary. It changes on every build, so committing it grows history
# on each commit; the vendored ffmpeg archive below is a one-off by comparison.
MERGE-VIDEOS.exe
*.exe
!vendor/*.exe

# Its checksum, published beside it on a release so the self-updater can check
# what it downloaded. Regenerated with the binary, so it is not history either.
*.exe.sha256

# Local media and merge outputs
*.mp4
*.mov
*.mkv
*.avi
*.m4v
*.webm
*.wmv
*.flv
*.mpg
*.mpeg
*.ts
*.m2ts
*.mts
*.3gp
merged*.mp4

# OS/editor noise
Thumbs.db
.DS_Store
*.tmp
*.log
